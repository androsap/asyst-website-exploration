    "autoprefixer": "^10.6.1",
    "dotenv": "^16.6.1",
    "eslint": "^8.38.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.3.4",
    "postcss": "^8.5.29",
    "sass": "^1.63.6",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.0.2",
    "vite": "^4.3.9",
    "vite-plugin-pwa": "^0.16.7",
    "vite-plugin-svgr": "^3.3.0",
